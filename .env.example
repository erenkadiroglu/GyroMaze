# GyroMaze Ortam Değişkenleri Şablonu (.env.example)

# İstemci (Next.js + WebSocket Proxy) Sunucu Portu
PORT=3000

# Arka Uç (NestJS + Socket.io) WebSocket Sunucu Portu
BACKEND_PORT=4000

# İsteğe Bağlı: Harici bir WebSocket sunucu adresi kullanılacaksa belirtin.
# Boş bırakıldığında istemci otomatik olarak kendi origin adresini (veya yerel 4000 portunu) kullanır.
# NEXT_PUBLIC_SOCKET_URL=https://api.gyromaze.example.com

